Notebook[{
Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"x", ",", "y", ",", "W1", ",", "W2", ",", "t"}], "]"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Fitness", " ", "landscape"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"w", "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"0.9", " ", 
      RowBox[{"Exp", "[", 
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"x", "-", "0.3"}], ")"}], "^", "2"}], "/", "0.02"}], "+", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"y", "-", "0.7"}], ")"}], "^", "2"}], "/", "0.04"}]}], 
         ")"}]}], "]"}]}], "+", 
     RowBox[{"1.1", " ", 
      RowBox[{"Exp", "[", 
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"x", "-", "0.75"}], ")"}], "^", "2"}], "/", "0.03"}], 
          "+", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"y", "-", "0.25"}], ")"}], "^", "2"}], "/", "0.03"}]}], 
         ")"}]}], "]"}]}], "+", 
     RowBox[{"0.2", " ", 
      RowBox[{"Exp", "[", 
       RowBox[{"-", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"x", "-", "y"}], ")"}], "^", "2"}], "/", "0.1"}], ")"}]}],
        "]"}], " ", 
      RowBox[{"Sin", "[", 
       RowBox[{"4", " ", 
        RowBox[{"(", 
         RowBox[{"x", "+", "y"}], ")"}]}], "]"}]}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"dw", ":=", 
   RowBox[{"Grad", "[", 
    RowBox[{
     RowBox[{"w", "[", 
      RowBox[{"x", ",", "y"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Ne", "=", "10"}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"driftX", "[", 
    RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
   RowBox[{"x", " ", 
    RowBox[{"(", 
     RowBox[{"1", "-", "x"}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"dw", "[", 
       RowBox[{"[", "1", "]"}], "]"}], "/.", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"x", "->", "x"}], ",", 
        RowBox[{"y", "->", "y"}]}], "}"}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"driftY", "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
    RowBox[{"y", " ", 
     RowBox[{"(", 
      RowBox[{"1", "-", "y"}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"dw", "[", 
        RowBox[{"[", "2", "]"}], "]"}], "/.", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"x", "->", "x"}], ",", 
         RowBox[{"y", "->", "y"}]}], "}"}]}], ")"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sigmaX", "[", "x_", "]"}], ":=", 
   RowBox[{"Sqrt", "[", 
    RowBox[{"x", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", "x"}], ")"}], "/", 
      RowBox[{"(", 
       RowBox[{"2", " ", "Ne"}], ")"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"sigmaY", "[", "y_", "]"}], ":=", 
    RowBox[{"Sqrt", "[", 
     RowBox[{"y", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", "y"}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"2", " ", "Ne"}], ")"}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"CORRECT", " ", "ItoProcess"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"wfProcess", "[", 
    RowBox[{"startX_", ",", "startY_"}], "]"}], ":=", 
   RowBox[{"ItoProcess", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"\[DifferentialD]", 
         RowBox[{"x", "[", "t", "]"}]}], "==", 
        RowBox[{
         RowBox[{
          RowBox[{"driftX", "[", 
           RowBox[{
            RowBox[{"x", "[", "t", "]"}], ",", 
            RowBox[{"y", "[", "t", "]"}]}], "]"}], 
          RowBox[{"\[DifferentialD]", "t"}]}], "+", 
         RowBox[{
          RowBox[{"sigmaX", "[", 
           RowBox[{"x", "[", "t", "]"}], "]"}], " ", 
          RowBox[{"\[DifferentialD]", 
           RowBox[{"W1", "[", "t", "]"}]}]}]}]}], ",", 
       RowBox[{
        RowBox[{"\[DifferentialD]", 
         RowBox[{"y", "[", "t", "]"}]}], "==", 
        RowBox[{
         RowBox[{
          RowBox[{"driftY", "[", 
           RowBox[{
            RowBox[{"x", "[", "t", "]"}], ",", 
            RowBox[{"y", "[", "t", "]"}]}], "]"}], 
          RowBox[{"\[DifferentialD]", "t"}]}], "+", 
         RowBox[{
          RowBox[{"sigmaY", "[", 
           RowBox[{"y", "[", "t", "]"}], "]"}], " ", 
          RowBox[{"\[DifferentialD]", 
           RowBox[{"W2", "[", "t", "]"}]}]}]}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"x", "[", "t", "]"}], ",", 
       RowBox[{"y", "[", "t", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", "y"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"startX", ",", "startY"}], "}"}]}], "}"}], ",", "t", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"W1", "\[Distributed]", 
        RowBox[{"WienerProcess", "[", "]"}]}], ",", 
       RowBox[{"W2", "\[Distributed]", 
        RowBox[{"WienerProcess", "[", "]"}]}]}], " ", "}"}]}], "]"}]}], 
  ";"}]}], "Input",
