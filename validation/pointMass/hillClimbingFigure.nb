          RowBox[{"{", 
           RowBox[{"0", ",", "1", ",", "0.01"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"pts", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"#1", ",", "#2", ",", 
             RowBox[{"w", "[", 
              RowBox[{"#1", ",", "#2"}], "]"}]}], "}"}], "&"}], ")"}], "@@@", 
         RowBox[{"path", "[", "\"\<Values\>\"", "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"end", " ", "=", " ", 
        RowBox[{"FirstPosition", "[", 
