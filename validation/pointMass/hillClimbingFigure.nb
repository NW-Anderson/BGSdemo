 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"traj", "[", "start_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"path", ",", "pts", ",", " ", "end"}], "}"}], ",", 
