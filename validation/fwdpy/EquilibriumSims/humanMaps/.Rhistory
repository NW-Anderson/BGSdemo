par <- params %>% filter(paste(seed,".csv",sep="")==file)
df <- fread(file) %>% as.matrix()
df <- df[,1]
master <- dplyr::bind_rows(master,data.table(s = par$s,
N = par$N,
seed = par$seed,
frq = df))
}
?geom_density
ggplot(df) +
geom_density(aes(frq)) +
facet_grid(rows = vars(s),
cols = vars(N),
scales = "free")
ggplot(master) +
geom_density(aes(frq)) +
facet_grid(rows = vars(s),
cols = vars(N),
scales = "free")
ggplot(master) +
geom_density(aes(frq, linetype = N, color = s))
ggplot(master) +
geom_density(aes(frq, color = s)) +
facet_wrap(N)
ggplot(master) +
geom_density(aes(frq, color = s)) +
facet_wrap(vars(N))
ggplot(master) +
geom_density(aes(frq, color = as.factor(s))) +
facet_wrap(vars(N))
ggplot(master) +
geom_density(aes(frq, color = as.factor(s))) +
facet_wrap(vars(N)) +
scale_y_log10()
ggplot(master) +
geom_density(aes(frq, color = as.factor(s))) +
facet_wrap(vars(N)) +
scale_y_log10()+
scale_x_log10()
master %>% group_by(N,s) %>% summarize(densx = density(freq)$x)
master %>% group_by(N,s) %>% summarize(densx = density(frq)$x)
master %>% group_by(N,s) %>% reframe(densx = density(frq)$x)
?density
density(master$frq)
master %>% group_by(N,s) %>% reframe(densx = density(frq, from =1/(2*N), to = 1 - 1/(2*N))$x,
densy = density(frq, from =1/(2*N), to = 1 - 1/(2*N))$y)
master %>% group_by(N,s) %>% reframe(densx = density(frq, from =1/(2*unique(N)), to = 1 - 1/(2*unique(N)))$x,
densy = density(frq, from =1/(2*unique(N)), to = 1 - 1/(2*unique(N)))$y)
dens <- master %>% group_by(N,s) %>% reframe(densx = density(frq, from =1/(2*unique(N)), to = 1 - 1/(2*unique(N)))$x,
densy = density(frq, from =1/(2*unique(N)), to = 1 - 1/(2*unique(N)))$y)
ggplot(dens) +
geom_line(x = densx, y= densy, color = as.factor(s), linetype = as.factor(N))
ggplot(dens) +
geom_line(aes(x = densx, y= densy, color = as.factor(s), linetype = as.factor(N)))
dens <- master %>% group_by(N,s) %>%
reframe(densx = density(frq,
from =1/(2*unique(N)),
to = 1 - 1/(2*unique(N)))$x,
densy = density(frq,
from =1/(2*unique(N)),
to = 1 - 1/(2*unique(N)))$y) %>%
mutate(densy = densy / max(densy)) %>%
ungroup()
ggplot(dens) +
geom_line(aes(x = densx, y= densy, color = as.factor(s), linetype = as.factor(N)))
?mutate_each
dens <- master %>% group_by(N,s) %>%
reframe(densx = density(frq,
from =1/(2*unique(N)),
to = 1 - 1/(2*unique(N)))$x,
densy = density(frq,
from =1/(2*unique(N)),
to = 1 - 1/(2*unique(N)))$y,
mx = max(densy))
unique(dens$mx)
dens <- master %>% group_by(N,s) %>%
reframe(densx = density(frq,
from =1/(2*unique(N)),
to = 1 - 1/(2*unique(N)))$x,
densy = density(frq,
from =1/(2*unique(N)),
to = 1 - 1/(2*unique(N)))$y,
mx = max(densy)) %>%
mutate(densy = densy / mx) %>%
ungroup()
ggplot(dens) +
geom_line(aes(x = densx, y= densy, color = as.factor(s), linetype = as.factor(N)))
