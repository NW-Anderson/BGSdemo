mxi = 0
mxbigU = 0
for(i in seq(1e4, 50819000,1e4)){
tmp <- exonMutMap %>% filter(start >= i - 1e6/2 & stop <= i + 1e6/2)
tmp <- tmp %>% mutate(bigU = (stop - start) * rate)
bigU <- sum(tmp$bigU)
if(bigU > mxbigU){
mxbigU = bigU
mxi = i
}
}
