library(dplyr)
master <- data.frame()
for(s in c(1e-3,5e-3,1e-2)){
for(n in c(1e3,5e3,1e4)){
for(rep in 1:1000){
master <- dplyr::bind_rows(master,
data.frame(s,
n))
}
}
}
master$seed <- sample(1:1e5,nrow(master))
write.table(master, file = "morereps.txt",
row.names = F,col.names = F, quote=F)
