for(curs in unique(master$s)){
for(curN in unique(master$N)){
for(curwi in unique(master$wi)){
tmp <- master %>% filter(s == curs,
N == curN,
wi = curwi)
fwrite(list(tmp$obs),paste(curs,"_",curN,"_",curwi,".csv",sep=""))
}
}
}
